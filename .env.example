# Copy this file to .env (same folder) and fix any paths that differ on your machine.
# Run `echo $HOME` on the server if you're unsure what your home folder is.

# Folder holding one sub-folder per city: <city>/<city>_locs.csv, mask2former_<city>.npy, siglip_<city>.npy
EMB_ROOT=/home/research/Documents/researchers/ashley

# Street View images for each city (filenames must match the "filename" column of <city>_locs.csv)
IMG_DIR_NEWYORK=/data/Datasets/NY_gsv_oct_22/img
IMG_DIR_LONDON=/data/Datasets/london_6247/img
IMG_DIR_BOSTON=/data/Datasets/boston_gsv_sep_22/img

# Where the pipeline writes its outputs (test sets, sketches, prompts, query embeddings), one folder per city
OUT_ROOT=/home/research/Documents/researchers/ashley/placeify/data

# OpenAI key for sketches and text prompts (keep this file private; never commit it)
OPENAI_API_KEY=
